rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.isAdmin == true ||
        request.auth.token.role == 'admin'
      );
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.role == 'staff' ||
        request.auth.token.isStaff == true
      );
    }

    // Announcements assets: public read, admin/staff write
    match /announcements/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() || isStaff();
    }

    // Baptismal register scan archives: contain full-resolution photos of
    // register spreads -- typically ~10 children's records per page, many
    // of them minors. Read AND write are restricted to admin/staff only
    // (unlike announcements, this must never be publicly readable).
    match /baptism_scans/{allPaths=**} {
      allow read: if isAdmin() || isStaff();
      allow write: if isAdmin() || isStaff();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
