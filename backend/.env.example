# Backend environment variables (copy to .env and fill in).

PORT=3000

# Firebase Admin SDK service account (full JSON on one line).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:3000

# EmailJS (transactional email / verification codes).
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# OCR.space API key (handwriting OCR for register scanning).
# Free key (no card): https://ocr.space/ocrapi
OCRSPACE_API_KEY=
