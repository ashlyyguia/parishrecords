# Backend environment variables (copy to .env and fill in).

PORT=3000

# Firebase Admin SDK service account (full JSON on one line).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:3000

# EmailJS (transactional email / verification codes).
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Optional EmailJS template for the welcome email sent after registration.
# Template subject: {{subject}}   Template body (HTML): {{{message_html}}}
EMAILJS_WELCOME_TEMPLATE_ID=

# Welcome email over SMTP instead of EmailJS (used when SMTP_HOST is set).
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=<address>
#        SMTP_PASS=<16-character app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Name and link used in the welcome email.
PARISH_NAME=Holy Parish
APP_URL=https://holyparish.web.app

# OCR.space API key (handwriting OCR for register scanning).
# Free key (no card): https://ocr.space/ocrapi
OCRSPACE_API_KEY=

# Google Cloud Vision — handwriting OCR for baptismal registers.
# Service-account JSON, single line. Falls back to FIREBASE_SERVICE_ACCOUNT_JSON
# when unset (same GCP project; the Vision API must be enabled on it).
GOOGLE_CLOUD_VISION_CREDENTIALS_JSON=
